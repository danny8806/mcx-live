# .env.example — LIVE-only credential seed.
# Copy to mcx-trader.env, fill with REAL values, then run:
#   python scripts/gen_service_envs.py
# to generate .env.live for docker-compose. All such *.env files are gitignored.
#
# Dhan (required for LIVE trading + market-data auth; the DhanRestTransport and
# gate/poll paths stay inert until real credentials are set).
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=
TRADING_PIN=
TOTP_SECRET=

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# VPS deployment (optional; used only by deploy_vps.py at deploy time)
VPS_PASS=

# ------------------------------------------------------------------------------
# Runtime-mode guards set by scripts/gen_service_envs.py into .env.live:
#   TRADING_MODE=LIVE  REAL_ORDER_EXECUTION=1  BROKER_ENABLED=1
#   LIVE_PORT=8001 (healthcheck + nginx upstream)
#   APP_API_BASE="" APP_WS_BASE=""  -> SPA served same-origin by nginx
# ------------------------------------------------------------------------------